[Desktop Entry]
Type=Application
Name=Kritzel Handwriting Panel
Name[de]=Kritzel Handschrift-Eingabe
Comment=Write with a pen; the recognised text is typed into the focused text field
Comment[de]=Mit dem Stift schreiben; der erkannte Text wird in das aktive Textfeld eingegeben
Exec=@EXEC@
Icon=draw-freehand
NoDisplay=true
X-KDE-Wayland-VirtualKeyboard=true
